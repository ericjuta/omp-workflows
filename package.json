{
  "name": "@ericjuta/omp-workflows",
  "version": "0.14.2",
  "description": "Workflow and controller runtime with native OMP integration and a live terminal viewer",
  "keywords": [
    "omp-plugin",
    "pi-package"
  ],
  "homepage": "https://github.com/ericjuta/omp-workflows#readme",
  "bugs": {
    "url": "https://github.com/ericjuta/omp-workflows/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ericjuta/omp-workflows.git"
  },
  "bin": {
    "omp-workflows": "dist/viewer/cli.js"
  },
  "files": [
    "assets",
    "dist",
    "src",
    "skills",
    "examples",
    "docs",
    "schemas",
    "plugins/herdr",
    "herdr-plugin.toml",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/workflows/index.d.ts",
      "default": "./dist/workflows/index.js"
    },
    "./extension": {
      "types": "./dist/extension/index.d.ts",
      "default": "./dist/extension/index.js"
    },
    "./controllers": {
      "types": "./dist/controllers/index.d.ts",
      "default": "./dist/controllers/index.js"
    },
    "./builtins": {
      "types": "./dist/builtins/index.d.ts",
      "default": "./dist/builtins/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test:coverage",
    "fixtures": "node scripts/export-layout-fixtures.mjs",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings src test examples",
    "prepare": "node scripts/prepare.mjs",
    "release:check": "node scripts/release-verify.mjs check-metadata",
    "release:inventory": "node scripts/release-verify.mjs check-inventory --allow-dirty",
    "release:prepare": "node scripts/release-verify.mjs prepare",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:host-soak": "node scripts/host-soak.mjs",
    "test:host-soak:release": "node scripts/host-soak.mjs --release",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.80.10",
    "@earendil-works/pi-coding-agent": "^0.80.10",
    "@earendil-works/pi-tui": "^0.80.10",
    "@types/node": "^26.1.1",
    "@vitest/coverage-istanbul": "^4.1.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "omp": {
    "extensions": [
      "./src/extension/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
